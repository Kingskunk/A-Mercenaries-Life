        lines.push(p + " handed Daven's crooked tax books to Bram Tallow, and Oxworth cattlemen hauled Daven off to Hartwell in rope. Vera now rides out alone on market days to handle the buying accounts while Daven sits in a Hartwell lockup.");
      } else if (s.ox_hh_ending === "extorted") {
        lines.push(p + " bled Daven for heavy silver over his crooked tax books. Daven is too rattled to show his face in Oxworth now, so Vera rides out alone on market days to buy hides.");
      } else {
        lines.push("Daven still rides out to Oxworth on market days and sits downstairs drinking and throwing dice at The Yoke & Horn, completely oblivious while Vera invites " + p + " upstairs.");
      }
      if (s.ox_hh_vera_bedded === true || s.ox_hh_vera_bedded === "true") {
        lines.push("Vera and " + p + " already spent a reckless night together in Daven's room upstairs at The Yoke & Horn.");
