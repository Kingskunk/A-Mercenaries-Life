      if (s.ox_hh_flask_shown_vera === true || s.ox_hh_flask_shown_vera === "true") {
        lines.push(p + " still carries Daven's engraved silver hip flask taken off his chest that first night.");
      }
    } else {
      lines.push("Daven dragged her to Oxworth to punish her for smiling at someone in Hartwell, and leaves her upstairs alone every night while he drinks and throws dice downstairs at The Yoke & Horn.");
      lines.push("Vera tipped " + p + " off about the two rigged tax books inside Daven's lost saddlebag and invited " + p + " up to Daven's own rented room while Daven plays bone dice below.");
      if (s.ox_hh_beast_dead === true || s.ox_hh_beast_dead === "true") {
