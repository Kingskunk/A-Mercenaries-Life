{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lint current file (all per-file linters)",
            "type": "shell",
            "command": "node tools/lint_all.js \"${file}\"",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Lint current file: choice length only",
            "type": "shell",
            "command": "node tools/lint_choice_length.js \"${file}\"",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Lint all scenes (per-file linters)",
            "type": "shell",
            "command": "node tools/lint_all.js",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Lint place text (thin hubs and re-entry lines, slow)",
            "type": "shell",
            "command": "node tools/lint_thin_places.js",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Dead space across a random walk (slow, a few minutes)",
            "type": "shell",
            "command": "node randomtest.js num=4 showDeadSpace=true showCoverage=false showChoices=false",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Simulate weather (400 days)",
            "type": "shell",
            "command": "node tools/sim_weather.js days=400",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Quicktest current scene (seconds)",
            "type": "shell",
            "command": "node tools/quicktest_scene.js \"${file}\"",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Quicktest (the full game, several minutes)",
            "type": "shell",
            "command": "node quicktest.js",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        }
    ]
}
